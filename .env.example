# 复制为 .env 后填写（.env 勿提交）

# SSH / 部署
ssh_server=YOUR.SERVER.IP
ssh_port=22
ssh_user=root
ssh_pwd=

# 远程 backend 目录
deploy_remote_dir=/home/rock/project/lingxi

# App 默认服务器（Gradle 构建注入 BuildConfig）
# 若省略 app_server_host，则使用 ssh_server
app_server_host=YOUR.SERVER.IP
app_http_port=8000
app_ws_port=8000
app_use_tls=false
app_ws_path=/ws
