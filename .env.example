# 复制为 .env 后填写（.env 勿提交）

# SSH / 部署
ssh_server=YOUR.SERVER.IP
ssh_port=22
ssh_user=root
ssh_pwd=

# 远程：源码编译目录 / 运行目录（systemd）
deploy_remote_dir=/home/rock/project/lingxi
deploy_app_dir=/home/rock/apps/lingxi
# 远端 systemd 的 DATABASE_URL（可与本地 DATABASE_URL 不同）
deploy_database_url=postgres://lingxi:lingxi@127.0.0.1:5432/lingxi
deploy_compose_dir=/home/rock/apps/lingxi
deploy_postgres_data_dir=/home/rock/data/lingxi-postgres

# App 默认服务器（Gradle 构建注入 BuildConfig）
# 若省略 app_server_host，则使用 ssh_server
app_server_host=YOUR.SERVER.IP
app_http_port=8000
app_ws_port=8000
app_use_tls=false
app_ws_path=/ws

# PostgreSQL（Docker Compose 默认账号；后端 / systemd 共用）
POSTGRES_USER=lingxi
POSTGRES_PASSWORD=lingxi
POSTGRES_DB=lingxi
POSTGRES_PORT=5432
DATABASE_URL=postgres://lingxi:lingxi@127.0.0.1:5432/lingxi

# 宿主机数据目录（挂到容器 /var/lib/postgresql/data）
# Windows 示例: C:/rock/data/lingxi-postgres  或  C:\rock\data\lingxi-postgres
# Linux 示例:   /home/rock/data/lingxi-postgres
# 也可用相对路径: ./data/postgres
POSTGRES_DATA_DIR=/home/rock/apps/lingxi/postgres
